.main-menu-button {
    width: 200px;
    height: 50px;
    margin-bottom: 10px;
    border-radius: 10px;
    color: rgb(68, 68, 68);
    background-color: rgb(234, 231, 230);
    transition: all, 0.1s, ease-in-out;
    scale: 1;
}

.main-menu-button:hover {
    scale: 1.05;
    background-color: rgb(250, 248, 247);
    transition: all, 0.2s, ease-in-out;
}

 .menu-screen--hidden {
    opacity: 0;
     transition: opacity, 0.3s, ease-in-out;
 }

 .menu-screen {
     opacity: 1;
     transition: opacity, 0.3s, ease-in-out;
 }